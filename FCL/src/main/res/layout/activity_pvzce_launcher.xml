<?xml version="1.0" encoding="utf-8"?>
<!-- Adapted from FCL activity_main: independent navigation, with no account/download widgets. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
 xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/pvzce_background"
 android:layout_width="match_parent" android:layout_height="match_parent">
<ScrollView android:id="@+id/pvzce_left_menu" android:layout_width="64dp" android:layout_height="0dp" android:background="@drawable/bg_game_menu" android:fillViewport="true" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:paddingVertical="8dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:paddingBottom="8dp">
<com.tungsten.fcllibrary.component.view.FCLMenuView android:id="@+id/pvzce_nav_home" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_baseline_home_24" android:contentDescription="@string/pvzce_home" />
<TextView android:id="@+id/pvzce_label_home" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/pvzce_home" android:textSize="12sp" />
</LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:paddingBottom="8dp">
<com.tungsten.fcllibrary.component.view.FCLMenuView android:id="@+id/pvzce_nav_content" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_baseline_folder_24" android:contentDescription="@string/pvzce_content" />
<TextView android:id="@+id/pvzce_label_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/pvzce_content" android:textSize="12sp" />
</LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:paddingBottom="8dp">
<com.tungsten.fcllibrary.component.view.FCLMenuView android:id="@+id/pvzce_nav_settings" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_baseline_settings_24" android:contentDescription="@string/pvzce_settings" />
<TextView android:id="@+id/pvzce_label_settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/pvzce_settings" android:textSize="12sp" />
</LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:paddingBottom="8dp">
<com.tungsten.fcllibrary.component.view.FCLMenuView android:id="@+id/pvzce_nav_advanced" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_baseline_tune_24" android:contentDescription="@string/pvzce_advanced" />
<TextView android:id="@+id/pvzce_label_advanced" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/pvzce_advanced" android:textSize="12sp" />
</LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:paddingBottom="8dp">
<com.tungsten.fcllibrary.component.view.FCLMenuView android:id="@+id/pvzce_nav_logs" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_terminal_outlined" android:contentDescription="@string/pvzce_logs" />
<TextView android:id="@+id/pvzce_label_logs" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/pvzce_logs" android:textSize="12sp" />
</LinearLayout></LinearLayout></ScrollView>
<LinearLayout android:id="@+id/pvzce_right_menu" android:layout_width="0dp" android:layout_height="0dp" android:orientation="vertical" android:padding="12dp" android:gravity="center" android:background="@drawable/bg_right_menu" app:layout_constraintWidth_percent="0.25" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent">
<com.tungsten.fcllibrary.component.view.FCLTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PVZCE Launcher" android:textStyle="bold" android:textSize="18sp" app:use_theme_color="true" />
<com.tungsten.fcllibrary.component.view.FCLTextView android:id="@+id/pvzce_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="8dp" android:maxLines="3" android:ellipsize="end" app:use_theme_color="true" />
<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginBottom="8dp">
<com.tungsten.fcllibrary.component.view.FCLTextView android:id="@id/pvzce_status" android:accessibilityLiveRegion="polite" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/pvzce_ready" android:textSize="12sp" app:use_theme_color="true" />
</ScrollView>
<com.tungsten.fcllibrary.component.view.FCLButton android:id="@+id/pvzce_jar_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/pvzce_import_jar" android:textAllCaps="false" app:ripple="true" />
<com.tungsten.fcllibrary.component.view.FCLButton android:id="@+id/pvzce_render_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/pvzce_runtime_settings" android:textAllCaps="false" app:ripple="true" />
<com.tungsten.fcllibrary.component.view.FCLButton android:id="@+id/pvzce_start" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="8dp" android:text="@string/pvzce_launch" android:textAllCaps="false" android:textStyle="bold" app:ripple="true" />
</LinearLayout>
<com.tungsten.fcllibrary.component.view.FCLDynamicIsland android:id="@+id/pvzce_title" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginTop="8dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toEndOf="@id/pvzce_left_menu" app:layout_constraintEnd_toStartOf="@id/pvzce_right_menu" />
<FrameLayout android:id="@+id/pvzce_pages" android:layout_width="0dp" android:layout_height="0dp" android:layout_margin="12dp" app:layout_constraintStart_toEndOf="@id/pvzce_left_menu" app:layout_constraintEnd_toStartOf="@id/pvzce_right_menu" app:layout_constraintTop_toBottomOf="@id/pvzce_title" app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
